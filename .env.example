# moemail 临时邮箱
MOEMAIL_API_KEY=mk_your_api_key_here
MOEMAIL_BASE_URL=https://your-moemail-instance.example.com

# 出口代理(可选,留空则直连)
# 支持 http:// / https:// / socks5:// / socks5h://
# socks5h:// 表示 DNS 也走代理解析,避免本地 DNS 泄漏出口特征
# PROXY=socks5h://user:pass@host:port

# 批量注册
REGISTER_COUNT=1          # 默认注册账号数量
REGISTER_CONCURRENT=1     # 默认并发数

# 账号文件
# ACCOUNTS_FILE=accounts.json

# claude.ai 请求头
CLAUDE_BASE_URL=https://claude.ai
CLAUDE_ACCEPT=*/*
CLAUDE_ACCEPT_LANGUAGE=en-US,en;q=0.9
# 留空/注释 = 按账号哈希从内置真实 UA 池轮换;填写则全局固定用它(禁用轮换)
# CLAUDE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
CLAUDE_CLIENT_PLATFORM=web_claude_ai
CLAUDE_CLIENT_VERSION=1.0.0
# 客户端真实构建版本 SHA,随 claude.ai 更新而变化
CLAUDE_CLIENT_SHA=

# anonymous-id / device-id / user-agent:为 1 时按账号邮箱哈希(uuid5)派生,同账号稳定、跨账号各异
# 为 0 时改用固定值(id 用下面两行,UA 用内置默认)
CLAUDE_RANDOMIZE_FINGERPRINT=1
# 固定回退值(仅在 CLAUDE_RANDOMIZE_FINGERPRINT=0 时使用)
# CLAUDE_ANONYMOUS_ID=
# CLAUDE_DEVICE_ID=
